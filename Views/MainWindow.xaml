<Window x:Class="ReservasApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Reservas"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F8">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ========================= -->
        <!-- PANEL LATERAL -->
        <!-- ========================= -->

        <Border Grid.Column="0"
                Background="#1E3A5F">

            <Grid>

                <StackPanel VerticalAlignment="Center"
                            Margin="25">

                    <!-- Logo / Nombre -->
                    <TextBlock Text="RESERVAS"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Sistema de gestión"
                               Foreground="#BFD3E6"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,40"/>


                    <!-- Indicadores visuales -->
                    <Border Background="#2B4F78"
                            CornerRadius="10"
                            Padding="15"
                            Margin="0,0,0,12">

                        <StackPanel>

                            <TextBlock Text="📚"
                                       FontSize="26"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Aulas"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>

                        </StackPanel>

                    </Border>


                    <Border Background="#2B4F78"
                            CornerRadius="10"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="📅"
                                       FontSize="26"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Reservas"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>

                        </StackPanel>

                    </Border>


                    <TextBlock Text="Gestión • Organización • Control"
                               Foreground="#8FAEC9"
                               FontSize="10"
                               TextAlignment="Center"
                               Margin="0,40,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================= -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ========================= -->

        <Grid Grid.Column="1"
              Margin="45">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ENCABEZADO -->

            <StackPanel Grid.Row="0">

                <TextBlock Text="Panel principal"
                           Foreground="#64748B"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBlock Text="{Binding Bienvenida}"
                           Foreground="#1E293B"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Selecciona una opción para administrar el sistema."
                           Foreground="#64748B"
                           FontSize="14"
                           Margin="0,0,0,30"/>

            </StackPanel>


            <!-- TÍTULO DE OPCIONES -->

            <TextBlock Grid.Row="1"
                       Text="Opciones disponibles"
                       Foreground="#334155"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Margin="0,0,0,15"/>


            <!-- BOTONES -->

            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- AULAS DATATABLE -->

                <Button Grid.Row="0"
                        Content="Aulas - Vista detallada"
                        Command="{Binding AulasDataTableCommand}"
                        Height="55"
                        Margin="0,5"
                        HorizontalContentAlignment="Left"
                        Padding="20,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#1E293B"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">

                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}"/>

                            </Border>

                        </ControlTemplate>
                    </Button.Template>

                </Button>


                <!-- AULAS OBJETOS -->

                <Button Grid.Row="1"
                        Content="Aulas - Gestión"
                        Command="{Binding AulasObjetosCommand}"
                        Height="55"
                        Margin="0,5"
                        HorizontalContentAlignment="Left"
                        Padding="20,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#1E293B"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">

                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}"/>

                            </Border>

                        </ControlTemplate>
                    </Button.Template>

                </Button>


                <!-- RESERVAS DATATABLE -->

                <Button Grid.Row="2"
                        Content="Reservas - Vista detallada"
                        Command="{Binding ReservasDataTableCommand}"
                        Height="55"
                        Margin="0,5"
                        HorizontalContentAlignment="Left"
                        Padding="20,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#1E293B"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">

                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}"/>

                            </Border>

                        </ControlTemplate>
                    </Button.Template>

                </Button>


                <!-- RESERVAS OBJETOS -->

                <Button Grid.Row="3"
                        Content="Reservas - Gestión"
                        Command="{Binding ReservasObjetosCommand}"
                        Height="55"
                        Margin="0,5"
                        HorizontalContentAlignment="Left"
                        Padding="20,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#1E293B"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">

                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}"/>

                            </Border>

                        </ControlTemplate>
                    </Button.Template>

                </Button>


                <!-- NUEVA RESERVA -->

                <Button Grid.Row="4"
                        Content="+   Nueva Reserva"
                        Command="{Binding NuevaReservaCommand}"
                        Height="55"
                        Margin="0,5"
                        HorizontalContentAlignment="Left"
                        Padding="20,0"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#1E3A5F"
                        BorderThickness="0"
                        Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="9">

                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}"/>

                            </Border>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>

        </Grid>

    </Grid>

</Window>
