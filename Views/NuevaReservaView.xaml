<Window x:Class="ReservasApp.Views.NuevaReservaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva Reserva"
        Height="560"
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F8">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ENCABEZADO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Nueva Reserva"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="Complete los datos para registrar una nueva reserva"
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- AULA -->

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,18">

            <TextBlock Text="Aula"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#334155"
                       Margin="0,0,0,6"/>

            <ComboBox ItemsSource="{Binding Aulas}"
                      SelectedItem="{Binding AulaSeleccionada}"
                      DisplayMemberPath="Nombre"
                      Height="40"
                      FontSize="14"
                      Padding="10,0"
                      Background="White"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"/>

        </StackPanel>


        <!-- FECHA Y HORA -->

        <Grid Grid.Row="2"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- FECHA -->

            <StackPanel Grid.Column="0">

                <TextBlock Text="Fecha"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>

                <DatePicker SelectedDate="{Binding Fecha}"
                            Height="40"
                            FontSize="14"/>

            </StackPanel>


            <!-- ESPACIO -->

            <Grid Grid.Column="1"/>


            <!-- HORA -->

            <StackPanel Grid.Column="2">

                <TextBlock Text="Hora"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>

                <Border Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="5"
                        Height="40">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>


                        <!-- HORA -->

                        <TextBox Grid.Column="0"
                                 Text="{Binding Hora}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="5"
                                 BorderThickness="0"
                                 Background="Transparent"/>


                        <!-- BOTONES -->

                        <StackPanel Grid.Column="1"
                                    Orientation="Vertical">
                            <Button Content="▲"
                                    Height="19"
                                    FontSize="9"
                                    Background="#E2E8F0"
                                    Foreground="#334155"
                                    BorderThickness="0"
                                    Click="SubirHora_Click"/>

                            <Button Content="▼"
                                    Height="19"
                                    FontSize="9"
                                    Background="#E2E8F0"
                                    Foreground="#334155"
                                    BorderThickness="0"
                                    Click="BajarHora_Click"/>


                        </StackPanel>

                    </Grid>

                </Border>

            </StackPanel>

        </Grid>


        <!-- MOTIVO -->

        <StackPanel Grid.Row="3">

            <TextBlock Text="Motivo"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#334155"
                       Margin="0,0,0,6"/>

            <TextBox Text="{Binding Motivo}"
                     Height="90"
                     FontSize="14"
                     Padding="10"
                     Background="White"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"/>


            <!-- GUARDAR -->

            <Button Content="Guardar Reserva"
                    Height="45"
                    Margin="0,22,0,0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#1E3A5F"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding GuardarCommand}">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Button.Template>

            </Button>

        </StackPanel>

    </Grid>

</Window>