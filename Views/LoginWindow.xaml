<Window x:Class="ReservasApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión - Reservas"
        Height="520"
        Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F8">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO -->
        <Border Grid.Column="0"
                Background="#1E3A5F">

            <Grid Margin="50">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="RESERVAS"
                               Foreground="White"
                               FontSize="38"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Sistema de gestión de reservas"
                               Foreground="#D9E6F2"
                               FontSize="17"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,35"/>

                    <Border Background="#2B4F78"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,15">

                        <StackPanel>

                            <TextBlock Text="📅"
                                       FontSize="32"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Organiza tus reservas"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>

                            <TextBlock Text="Administra aulas y reservas de manera sencilla."
                                       Foreground="#D9E6F2"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <TextBlock Text="Gestión • Organización • Control"
                               Foreground="#AFC5DA"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- PANEL DERECHO -->
        <Border Grid.Column="1"
                Background="White"
                Margin="0">

            <Grid Margin="55">

                <StackPanel VerticalAlignment="Center">

                    <!-- TÍTULO -->
                    <TextBlock Text="Bienvenido"
                               Foreground="#1E293B"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Inicia sesión para continuar"
                               Foreground="#64748B"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,35"/>


                    <!-- USUARIO -->
                    <TextBlock Text="Usuario"
                               Foreground="#334155"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Border Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="7"
                            Height="42"
                            Margin="0,0,0,20">

                        <TextBox BorderThickness="0"
                                 Background="Transparent"
                                 Padding="12,10"
                                 FontSize="14"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                    </Border>


                    <!-- CONTRASEÑA -->
                    <TextBlock Text="Contraseña"
                               Foreground="#334155"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Border Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="7"
                            Height="42"
                            Margin="0,0,0,30">

                        <PasswordBox x:Name="txtPassword"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="12,10"
                                     FontSize="14"/>

                    </Border>


                    <!-- BOTÓN -->
                    <Button Content="Ingresar"
                            Height="45"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#1E3A5F"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=txtPassword}">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="7">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <TextBlock Text="Sistema de Reservas"
                               Foreground="#94A3B8"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>
